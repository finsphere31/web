    localStorage.setItem('users', JSON.stringify(users));
    showAlert('Registered! Login now', 'success');
    showLogin();}    
    
    function sendOTP() {
    let username = document.getElementById('forgotUser').value.trim();
    if (!username) {
        showAlert('Enter username', 'warning');
        return;
    }
    let users = JSON.parse(localStorage.getItem('users')) || [];
    let user = users.find(u => u.username === username);
    if (!user) {
        showAlert('User not found', 'danger');
        return;
    }
    // Generate OTP
    generatedOTP = Math.floor(1000 + Math.random() * 9000).toString();

    // Use the user's mobile number if available, otherwise fallback to alert
    if (user.mobile && /^\d{10}$/.test(user.mobile)) {
        let message = `Your OTP for password reset is: ${generatedOTP}. Please use it within 5 minutes. - SubsManager`;
        let smsUrl = `sms:${user.mobile}?body=${encodeURIComponent(message)}`;
        // Open messaging app (works on mobile devices)
        window.open(smsUrl);
        showAlert(`OTP sent to ${user.mobile} via SMS.`, 'success');
    } else {
        // Fallback: show OTP in an alert
        showAlert(`No mobile number found. Your OTP: ${generatedOTP}`, 'warning');
    }

    // Show OTP input section
    document.getElementById('otpSection').classList.remove('hidden');}    
    function resetPassword() { let otp = document.getElementById('otpInput').value, newPass = document.getElementById('newPass').value, user = document.getElementById('forgotUser').value.trim(); if (otp !== generatedOTP) { showAlert('Invalid OTP', 'danger'); return; } let users = JSON.parse(localStorage.getItem('users')) || []; users = users.map(u => u.username === user ? { ...u, password: newPass } : u); localStorage.setItem('users', JSON.stringify(users)); showAlert('Password updated', 'success'); showLogin(); }
    function showLogin() { document.getElementById('loginBox').classList.remove('hidden'); document.getElementById('registerBox').classList.add('hidden'); document.getElementById('forgotBox').classList.add('hidden'); }
    function showRegister() { document.getElementById('loginBox').classList.add('hidden'); document.getElementById('registerBox').classList.remove('hidden'); document.getElementById('forgotBox').classList.add('hidden'); }
